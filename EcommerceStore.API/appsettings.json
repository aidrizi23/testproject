{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=EcommerceStore;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "SecretKey": "your-super-secret-key-at-least-32-characters-long-for-production",
    "Issuer": "EcommerceStoreAPI",
    "Audience": "EcommerceStoreClient",
    "ExpirationHours": "24"
  }
}
